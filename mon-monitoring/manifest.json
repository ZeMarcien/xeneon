{
    "author": "Mon Monitoring",
    "id": "com.local.monmonitoring",
    "name": "Mon Monitoring",
    "description": "Courbe d'un capteur sur une echelle fixe de 0 a 100 %, avec historique reglable de 1 a 5 minutes",
    "version": "1.1.0",
    "preview_icon": "resources/icon.svg",
    "min_framework_version": "1.0.0",
    "os": [
        {
            "platform": "windows"
        }
    ],
    "supported_devices": [
        {
            "type": "dashboard_lcd",
            "features": [
                "sensor-screen"
            ]
        }
    ],
    "interactive": true,
    "required_plugins": [
        "widgetbuilder.sensorsdataprovider:Sensors:1.0"
    ]
}